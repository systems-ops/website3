// Kitchen Compliance Log App — data model
// See design_handoff_kitchen_log/README.md for the source spec this implements.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per login attempt (success or failure), for rate limiting and
/// so an attack in progress is actually visible. Persisted (not in-memory)
/// because Vercel's serverless functions cold-start — an in-process counter
/// would reset on every new instance and protect nothing.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// "cook" | "manager"
  kind       String
  /// null for manager attempts — managers aren't location-scoped
  locationId String?
  ip         String
  succeeded  Boolean
  createdAt  DateTime @default(now())

  @@index([kind, locationId, ip, createdAt])
  @@map("login_attempts")
}

// --- Reference data -------------------------------------------------------

model Location {
  id   String @id @default(cuid())
  name String @unique

  logEntries              LogEntry[]
  certificateRequirements CertificateRequirement[]
  cooks                   CookLocation[]
  verifications           Verification[]

  @@map("locations")
}

/// A cook who can sign entries. Auth is a fast PIN switch on a shared kitchen
/// tablet, not email/password — see CookLocation for which kitchens a cook
/// can sign for.
model Cook {
  id      String  @id @default(cuid())
  name    String
  pinHash String
  active  Boolean @default(true)

  locations CookLocation[]
  sessions  Session[]

  @@map("cooks")
}

model CookLocation {
  cookId     String
  cook       Cook     @relation(fields: [cookId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([cookId, locationId])
  @@map("cook_locations")
}

model Session {
  id        String   @id @default(cuid())
  cookId    String
  cook      Cook     @relation(fields: [cookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([cookId])
  @@map("sessions")
}

/// A named manager/office account — distinct from the shared kitchen Cook
/// PINs, for the small set of forms that require a specific individual's
/// sign-off (e.g. CEO or SQF Practitioner approval) rather than "whoever's
/// on shift". Company-wide, not scoped to a location.
model Manager {
  id      String  @id @default(cuid())
  name    String
  role    String
  pinHash String
  active  Boolean @default(true)

  sessions         ManagerSession[]
  receivingReviews ReceivingReview[]
  verifications    Verification[]

  @@map("managers")
}

model ManagerSession {
  id        String   @id @default(cuid())
  managerId String
  manager   Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([managerId])
  @@map("manager_sessions")
}

/// The digitized paper forms (FR-08-A, FR-08, FR-11, FR-47-A, FR-02, ...).
/// `kind` is "temps" or "check". `unit` is "F" or "C" (temps forms only).
/// SQLite has no enum support, so these are validated as strings in the app layer.
model LogDefinition {
  id       String  @id // slug, e.g. "fridge"
  name     String
  formCode String
  kind     String
  unit     String?
  /// Ordered array of time-of-day slot labels, e.g. ["Morning","Midday","Afternoon"]. Temps forms only.
  slots    Json?
  revision Int     @default(1)
  active   Boolean @default(true)

  units                   LogUnit[]
  items                   LogItem[]
  entries                 LogEntry[]
  correctiveActionOptions CorrectiveActionOption[]
  certificateRequirements CertificateRequirement[]

  @@map("log_definitions")
}

/// One row per thing measured on a "temps" form (e.g. "Walk-in fridge").
model LogUnit {
  id              String @id @default(cuid())
  logDefinitionId String
  logDefinition   LogDefinition @relation(fields: [logDefinitionId], references: [id], onDelete: Cascade)
  name            String
  low             Float
  high            Float
  sortOrder       Int
  /// Overrides the form's unit suffix for this specific unit (e.g. seconds instead of degrees).
  unitOverride    String?

  readings Reading[]

  @@index([logDefinitionId])
  @@map("log_units")
}

/// One row per checklist line on a "check" form.
model LogItem {
  id              String @id @default(cuid())
  logDefinitionId String
  logDefinition   LogDefinition @relation(fields: [logDefinitionId], references: [id], onDelete: Cascade)
  label           String
  sortOrder       Int

  itemChecks ItemCheck[]

  @@index([logDefinitionId])
  @@map("log_items")
}

/// Preset corrective-action options offered when a temps reading is out of spec.
/// logDefinitionId = null is the fallback set used by any log without its own presets.
model CorrectiveActionOption {
  id              String         @id @default(cuid())
  logDefinitionId String?
  logDefinition   LogDefinition? @relation(fields: [logDefinitionId], references: [id], onDelete: Cascade)
  text            String
  sortOrder       Int

  @@index([logDefinitionId])
  @@map("corrective_action_options")
}

model Certificate {
  id   String @id @default(cuid())
  name String @unique

  requirements CertificateRequirement[]

  @@map("certificates")
}

/// Defines which logs a certificate requires, at what frequency, so certificate
/// status ("Fridge temperatures: 14 April missing") can be derived instead of hardcoded.
model CertificateRequirement {
  id              String        @id @default(cuid())
  certificateId   String
  certificate     Certificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  logDefinitionId String
  logDefinition   LogDefinition @relation(fields: [logDefinitionId], references: [id], onDelete: Cascade)
  /// null = applies at every location
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// e.g. "daily"
  frequency       String

  @@unique([certificateId, logDefinitionId, locationId])
  @@map("certificate_requirements")
}

// --- Submitted records ------------------------------------------------------

/// One row per submitted form. Immutable once created — corrections are new
/// rows referencing the original via `amendsId`, never an UPDATE.
model LogEntry {
  id              String        @id @default(cuid())
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id])
  logDefinitionId String
  logDefinition   LogDefinition @relation(fields: [logDefinitionId], references: [id])
  /// Calendar date the record is for, "YYYY-MM-DD" (kitchen-local, not UTC instant).
  businessDate    String
  submittedAt     DateTime      @default(now())
  /// Id (or name, pending auth) of the cook who submitted this record.
  submittedBy     String
  signatureName   String
  /// True when businessDate is yesterday relative to the server's Pacific
  /// "today" at submission time, computed server-side at write time — never
  /// trust the client's clock for this.
  enteredLate     Boolean       @default(false)
  lateReason      String?
  /// Required on amendments, always null on original entries — the "why",
  /// which an auditor reads for even more than the diff itself.
  amendReason     String?

  amendsId   String?
  amends     LogEntry?  @relation("Amendments", fields: [amendsId], references: [id])
  amendments LogEntry[] @relation("Amendments")

  readings         Reading[]
  itemChecks       ItemCheck[]
  calibrationRows  CalibrationRow[]
  receivingDetail  ReceivingDetail?
  receivingReview  ReceivingReview?

  @@index([locationId, logDefinitionId, businessDate])
  @@map("log_entries")
}

/// One row per submitted cell on a temps form.
/// The spec range is snapshotted at write time (specLow/specHigh/specUnitOverride)
/// so later changes to a unit's spec don't rewrite the meaning of past records.
model Reading {
  id                String   @id @default(cuid())
  logEntryId        String
  logEntry          LogEntry @relation(fields: [logEntryId], references: [id])
  logUnitId         String
  logUnit           LogUnit  @relation(fields: [logUnitId], references: [id])
  slotIndex         Int
  value             Float
  outOfSpec         Boolean
  specLow           Float
  specHigh          Float
  specUnitOverride  String?
  correctiveAction  String?

  @@unique([logEntryId, logUnitId, slotIndex])
  @@index([logUnitId])
  @@map("readings")
}

/// One row per thermometer tested on a "calibration" form submission
/// (e.g. FR-51-A). Unlike "temps" units, the thermometer being tested is
/// identified ad hoc per submission (a tag/ID typed in), not a predefined
/// LogUnit, so calibration rows aren't tied to a fixed reference list.
model CalibrationRow {
  id                 String   @id @default(cuid())
  logEntryId         String
  logEntry           LogEntry @relation(fields: [logEntryId], references: [id])
  rowIndex           Int
  testTermId         String
  referenceReading   Float
  testReading        Float
  adjustmentRequired Boolean
  comments           String?

  @@unique([logEntryId, rowIndex])
  @@map("calibration_rows")
}

/// One row per ticked checklist line on a "check" form submission.
/// A checklist line's result: PASS, FAIL (needs a corrective action, same
/// preset mechanism as an out-of-spec reading), or NA (needs a short reason).
/// A checklist submits successfully with FAILs present — the app must never
/// make non-compliance unrecordable.
model ItemCheck {
  id         String   @id @default(cuid())
  logEntryId String
  logEntry   LogEntry @relation(fields: [logEntryId], references: [id])
  logItemId  String
  logItem    LogItem  @relation(fields: [logItemId], references: [id])
  /// "PASS" | "FAIL" | "NA"
  status     String
  /// Required (validated in the app layer) when status is FAIL or NA —
  /// the corrective action taken, or the reason it doesn't apply.
  statusNote String?

  @@unique([logEntryId, logItemId])
  @@index([logItemId])
  @@map("item_checks")
}

/// The intake portion of a Receiving Log submission (FR-40) — filled in by
/// whoever's checking in the delivery. The management sign-off/testing
/// portion of that same paper form is deliberately split out into
/// ReceivingReview: it happens later, by a specific named manager, not at
/// intake time, so it can't be part of the same immutable creation.
model ReceivingDetail {
  id              String   @id @default(cuid())
  logEntryId      String   @unique
  logEntry        LogEntry @relation(fields: [logEntryId], references: [id])
  invoiceNumber   String
  distributorName String

  wfcfoApproved  Boolean
  wfcfoExplain   String?
  nonGmoApproved Boolean
  nonGmoExplain  String?

  truckConditionGood    Boolean
  truckConditionExplain String?
  truckTempCompliant    Boolean
  truckTempF            Float?

  palletConditionGood Boolean
  plasticWrapGood     Boolean

  productsToStandard        Boolean
  productsToStandardExplain String?
  labelsCurrent             Boolean
  labelsCurrentExplain      String?

  /// Folded in from the old standalone "Deliveries received" checklist
  /// (FR-02) — that form and this one always covered the same physical
  /// event (a truck arriving), so they're one form now instead of two.
  sealIntact                 Boolean
  caseCountMatches           Boolean
  supplierPaperworkAttached  Boolean
  organicCertCurrent         Boolean

  lines ReceivingLine[]

  @@map("receiving_details")
}

/// One row per product on a Receiving Log submission's product table.
model ReceivingLine {
  id                String          @id @default(cuid())
  receivingDetailId String
  receivingDetail   ReceivingDetail @relation(fields: [receivingDetailId], references: [id])
  rowIndex          Int
  productName       String
  productId         String?
  productCount      String?
  lotNumber         String?
  allergenProduct   Boolean
  labeledOrganic    Boolean
  /// "dry" | "refrig" | "freezer"
  storageType       String

  @@unique([receivingDetailId, rowIndex])
  @@map("receiving_lines")
}

/// The management testing/approval step on a Receiving Log entry — added
/// after intake, by a named Manager (not a shared cook PIN), and only once
/// per entry. Modeled as its own record rather than an update to
/// ReceivingDetail so intake stays immutable the same way every other log
/// entry does.
model ReceivingReview {
  id                String   @id @default(cuid())
  logEntryId        String   @unique
  logEntry          LogEntry @relation(fields: [logEntryId], references: [id])
  managerId         String
  manager           Manager  @relation(fields: [managerId], references: [id])
  reviewedAt        DateTime @default(now())

  totalCount        Int?
  countTested       Int?
  standardsReviewed String?
  coaReference      String?
  approved          Boolean
  rejectedReason    String?
  storageLocation   String?
  storageCcps       String?
  comments          String?
  releasedForUse    Boolean

  @@map("receiving_reviews")
}

/// A manager's weekly attestation that they reviewed a location's records —
/// SQF requires verification of monitoring, not just the monitoring itself.
/// One per location/week; never edited or deleted, only created.
model Verification {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  /// Monday of the verified week, "YYYY-MM-DD" — same string convention as
  /// businessDate, deliberately not a DateTime instant.
  weekStart  String
  managerId  String
  manager    Manager  @relation(fields: [managerId], references: [id])
  verifiedAt DateTime @default(now())
  comments   String?

  @@unique([locationId, weekStart])
  @@map("verifications")
}
