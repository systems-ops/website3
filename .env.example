# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=

# --- Seed PINs -------------------------------------------------------------
# Required by `npx prisma db seed`. 6-8 digits each. Generate fresh values —
# do not reuse anything that's ever appeared in chat, a screenshot, or a
# commit. See README.md for the recommended way to generate and rotate these.
COOK_PIN_1=
COOK_PIN_2=
COOK_PIN_3=
COOK_PIN_4=
COOK_PIN_5=
COOK_PIN_6=
COOK_PIN_7=
COOK_PIN_8=
COOK_PIN_9=
COOK_PIN_10=

MANAGER_PIN_FABRIZIO=
MANAGER_PIN_TIM=
MANAGER_PIN_SIMAR=

# Set to "true" to have `npx prisma db seed` print the PIN values it just
# set, for local use only. Leave unset (or "false") everywhere else —
# especially in Vercel's production environment, where seed output can end
# up in logs more people can see than should have credentials.
SEED_PRINT_PINS=false
